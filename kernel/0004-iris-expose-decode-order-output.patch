+		/* The decode-order request belongs to OUTPUT stream setup only. */
+		if ((i == DISPLAY_DELAY_ENABLE || i == DISPLAY_DELAY) &&
+		    !V4L2_TYPE_IS_OUTPUT(plane))
+			continue;
+
+		if (cap->cap_id && cap->set) {
+			ret = cap->set(inst, i);
+			if (ret)
+				return ret;
+		}
 	}
 
