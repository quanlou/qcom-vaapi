+int iris_set_decode_order(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id)
+{
+	const struct iris_hfi_session_ops *hfi_ops = inst->hfi_session_ops;
+	struct platform_inst_fw_cap *enable = &inst->fw_caps[DISPLAY_DELAY_ENABLE];
+	struct platform_inst_fw_cap *delay = &inst->fw_caps[DISPLAY_DELAY];
+	u32 order;
+
+	if (cap_id != DISPLAY_DELAY_ENABLE && cap_id != DISPLAY_DELAY)
+		return -EINVAL;
+
+	/* Preserve firmware defaults until a client explicitly requests a mode. */
+	if (!((enable->flags | delay->flags) & CAP_FLAG_CLIENT_SET))
+		return 0;
+
+	/* Qualcomm's Gen2 protocol uses 1 for decode-order output. */
+	order = enable->value && !delay->value;
+	return hfi_ops->session_set_property(inst, HFI_PROP_DECODE_ORDER_OUTPUT,
+					     HFI_HOST_FLAGS_NONE, HFI_PORT_BITSTREAM,
+					     HFI_PAYLOAD_U32, &order, sizeof(order));
 }
 
 int iris_set_u32(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id)
