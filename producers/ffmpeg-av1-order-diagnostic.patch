diff --git a/libavcodec/v4l2_context.c b/libavcodec/v4l2_context.c
index be1df3785b..3c62e6f10f 100644
--- a/libavcodec/v4l2_context.c
+++ b/libavcodec/v4l2_context.c
@@ -23,6 +23,7 @@
 
 #include <linux/videodev2.h>
 #include <sys/ioctl.h>
+#include <stdlib.h>
 #include <sys/mman.h>
 #include <unistd.h>
 #include <fcntl.h>
@@ -396,6 +397,40 @@ dequeue:
             return NULL;
         }
 
+        if (ctx->av_codec_id == AV_CODEC_ID_RAWVIDEO &&
+            ctx_to_m2mctx(ctx)->avctx->codec_id == AV_CODEC_ID_AV1 &&
+            !V4L2_TYPE_IS_OUTPUT(ctx->type) && getenv("IRIS_AV1_ORDER_DIAGNOSTIC")) {
+            unsigned payload = V4L2_TYPE_IS_MULTIPLANAR(ctx->type) ? planes[0].bytesused : buf.bytesused;
+            av_log(logger(ctx), AV_LOG_WARNING,
+                   "IRIS_AV1_CAPTURE index=%u sequence=%u flags=%u payload=%u timestamp=%lld:%lld\n",
+                   buf.index, buf.sequence, buf.flags, payload,
+                   (long long)buf.timestamp.tv_sec, (long long)buf.timestamp.tv_usec);
+        }
+
+        /* Iris may return an empty AV1 CAPTURE buffer for a non-display
+         * picture. Never publish mapped bytes when no payload was returned.
+         * ERROR also covers real corruption: keep an explicit diagnostic,
+         * and require full displayed-frame parity outside this experiment.
+         */
+        if (ctx->av_codec_id == AV_CODEC_ID_RAWVIDEO &&
+            ctx_to_m2mctx(ctx)->avctx->codec_id == AV_CODEC_ID_AV1 &&
+            !V4L2_TYPE_IS_OUTPUT(ctx->type) &&
+            (buf.flags & V4L2_BUF_FLAG_ERROR) &&
+            !(buf.flags & V4L2_BUF_FLAG_LAST) &&
+            (V4L2_TYPE_IS_MULTIPLANAR(buf.type) ?
+             buf.m.planes[0].bytesused : buf.bytesused) == 0) {
+            avbuf = &ctx->buffers[buf.index];
+            avbuf->status = V4L2BUF_AVAILABLE;
+            avbuf->buf = buf;
+            if (V4L2_TYPE_IS_MULTIPLANAR(ctx->type)) {
+                memcpy(avbuf->planes, planes, sizeof(planes));
+                avbuf->buf.m.planes = avbuf->planes;
+            }
+            av_log(logger(ctx), AV_LOG_WARNING,
+                   "AV1 diagnostic: empty ERROR capture recycled; no pixels published\n");
+            return avbuf;
+        }
+
         if (ctx_to_m2mctx(ctx)->draining && !V4L2_TYPE_IS_OUTPUT(ctx->type)) {
             int bytesused = V4L2_TYPE_IS_MULTIPLANAR(buf.type) ?
                             buf.m.planes[0].bytesused : buf.bytesused;
@@ -641,6 +676,20 @@ int ff_v4l2_context_dequeue_frame(V4L2Context* ctx, AVFrame* frame, int timeout)
         return AVERROR(EAGAIN);
     }
 
+    if (ctx_to_m2mctx(ctx)->avctx->codec_id == AV_CODEC_ID_AV1 &&
+        !V4L2_TYPE_IS_OUTPUT(ctx->type) &&
+        (avbuf->buf.flags & V4L2_BUF_FLAG_ERROR) &&
+        !(avbuf->buf.flags & V4L2_BUF_FLAG_LAST) &&
+        (V4L2_TYPE_IS_MULTIPLANAR(ctx->type) ?
+         avbuf->buf.m.planes[0].bytesused : avbuf->buf.bytesused) == 0) {
+        /* The receive-frame core consumes DISCARD internally and asks for
+         * another packet. EAGAIN here can violate send/receive progress.
+         * Never map or expose bytes belonging to an empty completion.
+         */
+        frame->flags |= AV_FRAME_FLAG_DISCARD;
+        return ff_v4l2_buffer_enqueue(avbuf);
+    }
+
     return ff_v4l2_buffer_buf_to_avframe(frame, avbuf);
 }
 
