diff --git a/libavcodec/v4l2_m2m.c b/libavcodec/v4l2_m2m.c
index 07c7500000..66209353ca 100644
--- a/libavcodec/v4l2_m2m.c
+++ b/libavcodec/v4l2_m2m.c
@@ -295,6 +295,18 @@ av_cold int ff_v4l2_m2m_codec_init(V4L2m2mPriv *priv)
 
     V4L2m2mContext *s = priv->context;
 
+    /* AV1 diagnostic must not probe unrelated camera nodes. */
+    if (s->avctx->codec_id == AV_CODEC_ID_AV1) {
+        const char *node = getenv("V4L2_VA_DEVICE");
+        if (!node || !*node || strlen(node) >= sizeof(s->devname))
+            return AVERROR(EINVAL);
+        memcpy(s->devname, node, strlen(node) + 1);
+        ret = v4l2_probe_driver(s);
+        if (ret)
+            return ret;
+        av_log(s->avctx, AV_LOG_INFO, "Using selected AV1 device %s\n", s->devname);
+        return v4l2_configure_contexts(s);
+    }
     dirp = opendir("/dev");
     if (!dirp)
         return AVERROR(errno);
diff --git a/libavcodec/v4l2_m2m_dec.c b/libavcodec/v4l2_m2m_dec.c
index ba1fe769e0..8ca664c13d 100644
--- a/libavcodec/v4l2_m2m_dec.c
+++ b/libavcodec/v4l2_m2m_dec.c
@@ -23,6 +23,7 @@
 
 #include <linux/videodev2.h>
 #include <sys/ioctl.h>
+#include <stdlib.h>
 #include "libavutil/pixfmt.h"
 #include "libavutil/pixdesc.h"
 #include "libavutil/opt.h"
@@ -212,6 +213,27 @@ static av_cold int v4l2_decode_init(AVCodecContext *avctx)
         return ret;
     }
 
+    /* Explicit isolated AV1 experiment; preserve defaults for all other runs. */
+    if (avctx->codec_id == AV_CODEC_ID_AV1 && getenv("IRIS_AV1_ORDER_DIAGNOSTIC")) {
+        const unsigned ids[] = { V4L2_CID_MPEG_VIDEO_DEC_DISPLAY_DELAY,
+                                 V4L2_CID_MPEG_VIDEO_DEC_DISPLAY_DELAY_ENABLE };
+        const int values[] = { 0, 1 };
+        if (strcmp(getenv("IRIS_AV1_ORDER_DIAGNOSTIC"), "1"))
+            return AVERROR(EINVAL);
+        for (unsigned i = 0; i < FF_ARRAY_ELEMS(ids); i++) {
+            struct v4l2_control control = { .id = ids[i], .value = values[i] };
+            if (ioctl(s->fd, VIDIOC_S_CTRL, &control) < 0)
+                return AVERROR(errno);
+            control.value = -1;
+            if (ioctl(s->fd, VIDIOC_G_CTRL, &control) < 0)
+                return AVERROR(errno);
+            if (control.value != values[i])
+                return AVERROR(EIO);
+            av_log(avctx, AV_LOG_WARNING, "IRIS_AV1_ORDER control=%u value=%d verified\n",
+                   ids[i], control.value);
+        }
+    }
+
     return v4l2_prepare_decoder(s);
 }
 
